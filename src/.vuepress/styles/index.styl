/**
 * Custom Styles here.
 *
 * ref：https://v1.vuepress.vuejs.org/config/#index-styl
 */

.home .hero img
  max-height 200px!important
  max-width 450px!important

.custom-block.tip
  background-color $paleColor !important
  border-color $accentColor !important

.home .hero .action-button
  padding 0.6rem 1.6rem !important
  border-radius 8px !important

.home .hero h1, .home .hero .description, .home .hero .action
  margin 0.8rem auto !important

.home .hero .description
  margin .8rem auto 1.6rem auto !important
  max-width 100% !important


// Features custom avec SVG
.features-custom
  display flex
  flex-wrap wrap
  justify-content center
  gap 1.5rem
  max-width 960px
  margin 2.5rem auto 0
  padding 0 2.5rem
  border-top 1px solid $borderColor
  padding-top 2.5rem

.feature-card
  flex 1
  min-width 240px
  max-width 300px
  text-align center

  h3
    font-size 1.15rem
    font-weight 600
    color $textColor
    margin 0.8rem 0 0.5rem
    border-bottom none

  p
    font-size 0.95rem
    color lighten($textColor, 25%)
    line-height 1.6

.feature-icon
  display inline-flex
  align-items center
  justify-content center

  svg
    width 48px
    height 48px
    color $accentColor

@media (max-width: 719px)
  .features-custom
    flex-direction column
    align-items center

  .feature-card
    max-width 100%

// Cercles décoratifs en arrière-plan
.bg-circle
  position fixed
  border-radius 50%
  pointer-events none
  z-index 0

.bg-circle--top-right
  width 1200px
  height 1200px
  top -500px
  right -500px
  background radial-gradient(circle, rgba(0, 117, 195, .3) 0%, transparent 70%)

.bg-circle--bottom-left
  width 1000px
  height 1000px
  bottom -400px
  left -500px
  background radial-gradient(circle, rgba(0, 117, 195, .3) 0%, transparent 70%)

// Mobile navbar: burger on the right of search, sidebar opens from right
@media (max-width: 719px)
  .navbar
    .sidebar-button
      position absolute
      right 0.75rem
      left auto

  header.navbar
    padding-left 1rem

  // Leave room so search does not overlap the burger icon
  .navbar .links
    margin-right 2.5rem

  .navbar .search-box
    margin-right 0.5rem

  // Open the sidebar from the right edge
  .sidebar
    left auto
    right 0
    transform translateX(100%)
    border-left 1px solid $borderColor
    border-right none

  .sidebar.open,
  .theme-container.sidebar-open .sidebar
    transform translateX(0)